# Copy to /srv/agent-studio/.env (mode 600, owner agents). Never commit the real file.
# These are the AGENTS' keys. The product's generator has its own keys in the product .env.

# GitHub token for the agents' account: classic token, "repo" scope only (no "workflow" scope).
GH_TOKEN=

# Free model providers (only the ones you use need a value)
OLLAMA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Shared test database for agents' tests (created by scripts/install.sh)
DATABASE_URL_TEST=postgresql://postgres:test@127.0.0.1:5433/studio_test
