# Fallback after Oracle (out of capacity) and AWS (account locked).
# Uses the Google Cloud free trial credit; see DELIVERY.md section 5.1.
terraform {
  required_version = ">= 1.6.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}
